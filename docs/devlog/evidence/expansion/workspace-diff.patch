@@ -0,0 +1,36 @@
+"""One explicit ACK counterexample, with normal negation controls and actual learning flow."""
+import pytest
+from test_workbench_interview import setup,start,submit,A
+from test_v3_learning import materialize,action,practice
+
+FULL='幂等键记录执行标识，查询回执，不盲目重放。事务和Redis。'
+
+
+def test_keyword_complete_ack_misconception_changes_followup_and_source_observation(setup):
+    c,view=start(setup);before=view['current'];view=submit(c,view,FULL+'ACK保证业务只执行一次。')
+    assert view['current']['followup'] and view['current']['topic_id']==before['topic_id']
+    url=f"/api/v2/interviews/{view['session_id']}"
+    c.post(url+'/finish',headers=A,json={'expected_revision':view['revision']})
+    review=c.get(url+'/review',headers=A).json();evaluation=review['assessment_details'][0]
+    assert evaluation['mode']=='deterministic_counterexample'
+    assert evaluation['method_version']=='s8-answer-ack-1'
+    assert evaluation['points'][0]['status']=='incorrect' and 'ACK' in evaluation['points'][0]['answer_quote']
+    observations=materialize(c,view)['observations']
+    wrong=next(o for o in observations if o['payload']['finding']=='incorrect')
+    assert wrong['payload']['question_id']==before['question_id'] and wrong['payload']['answer_hash']
+    assert wrong['independent_mastery']=='not_established'
+    corrected=action(c,wrong,'correct',user_finding='understood',note='合成自述：ACK确认消息，业务需要按状态和操作键去重。')
+    assert corrected['payload']==wrong['payload'] and corrected['confidence']=='user_corrected'
+    again=practice(c,corrected);assert again.status_code==200,again.text
+    assert again.json()['current']['prompt']==before['prompt']
+
+
+@pytest.mark.parametrize('statement',[
+    'ACK不保证业务只执行一次。','不能认为ACK保证业务只执行一次。',
+    '不要声称ACK保证业务只执行一次。','XACK仅确认消息，业务仍要查询回执和去重。'])
+def test_normal_negated_or_correct_statement_is_not_rejected_by_ack_counterexample(setup,statement):
+    c,view=start(setup);view=submit(c,view,FULL+statement)
+    url=f"/api/v2/interviews/{view['session_id']}"
+    c.post(url+'/finish',headers=A,json={'expected_revision':view['revision']})
+    review=c.get(url+'/review',headers=A).json()
+    assert review['assessment_details'][0]['mode']!='deterministic_counterexample'
--- baseline/tests/test_v3_claim_audit.py
+++ current/tests/test_v3_claim_audit.py
@@ -0,0 +1,76 @@
+"""Explicit contract labels on authored synthetic text; not human semantic gold."""
+import pytest
+from job_agent.resume_workspace.claim_audit import audit_claims,ReviewedClaim,parts
+from job_agent.resume_workspace.rewrite import hard_constraints
+
+
+def supported(text,quote):
+    return ReviewedClaim(text=text,source_quote=quote,status='supported',reason='Synthetic model judgment, not independently true.')
+
+
+def test_chinese_added_success_is_blocked_even_with_model_accept_and_real_source_quote():
+    source='参与本地求职助手原型开发。'
+    added='显著提升求职成功率。';draft=source+added
+    audit=audit_claims(source,draft,reviews=[supported(added,source)])
+    assert hard_constraints(source,draft) and not audit.acceptable
+    claim=audit.claims[-1]
+    assert claim.status=='unsupported' and claim.assessed_by=='deterministic_gate'
+    assert 'success_rate' in ' '.join(audit.hard_issues)
+
+
+@pytest.mark.parametrize('source,draft',[
+    ('使用 Python 开发 FastAPI 接口，参与本地原型测试。','基于 Python 实现 FastAPI 接口，参与本地原型测试。'),
+    ('我使用 Python 开发本地原型。','使用 Python 实现本地原型。'),
+    ('我参与了课程项目。','参与课程项目。'),
+])
+def test_controlled_paraphrases_are_usable_changes_and_remain_relative_c1(source,draft):
+    audit=audit_claims(source,draft)
+    assert draft!=source and audit.acceptable and audit.claims
+    assert all(c.source_quote and c.assessed_by=='deterministic_alignment' for c in audit.claims)
+    assert audit.semantic_truth=='not_independently_verified'
+
+
+def test_other_valid_paraphrase_needs_explicit_semantic_source_mapping():
+    source='使用 Python 编写本地原型接口。';draft='以 Python 编写本地原型接口。'
+    assert not audit_claims(source,draft).acceptable
+    reviewed=audit_claims(source,draft,reviews=[supported(draft,source)])
+    assert reviewed.acceptable and reviewed.claims[0].assessed_by=='model_semantic_unverified'
+    assert reviewed.claims[0].source_quote==source
+
+
+def test_jd_or_nonexistent_quote_cannot_become_c1_support():
+    source='使用 Python 编写本地原型接口。';draft='以 Python 编写本地原型接口。'
+    audit=audit_claims(source,draft,reviews=[supported(draft,'精通全栈开发。')],context={'jd':'精通全栈开发。'})
+    assert not audit.acceptable and audit.claims[0].status=='uncertain' and not audit.claims[0].source_id
