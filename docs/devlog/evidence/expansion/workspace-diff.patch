+    a.output.mkdir(parents=True,exist_ok=False)
+    bundle=ROOT/'tests/fixtures/expansion_research/index-v1';gate=ROOT/'docs/evaluation/expansion/retrieval-gate-v1.json'
+    run=evaluate(ROOT,bundle,a.output/'retrieval',variants=['A_bm25'],repeats=1,strict_algorithm=False)
