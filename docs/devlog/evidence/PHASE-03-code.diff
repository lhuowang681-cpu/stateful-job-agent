+++ M3/src/job_agent/resume_workspace/match_api.py
@@ -0,0 +1,49 @@
+from __future__ import annotations
+
+from fastapi import Depends, HTTPException
+
+from job_agent.resume_workspace.match_contracts import (
+    AnalyzeRequest, DecideProposal, DecisionResult, MatchError, MatchSummary, MatchView,
+)
+from job_agent.resume_workspace.match_repository import MatchRepository
+from job_agent.resume_workspace.matching import WorkbenchMatcher
+
+
+def install_matching_routes(app, workspace, owner, matcher: WorkbenchMatcher):
+    repository = MatchRepository(workspace)
+
+    @app.exception_handler(MatchError)
+    async def match_error(_request, exc):
+        from fastapi.responses import JSONResponse
+        return JSONResponse(status_code=503 if str(exc)=='match_model_unavailable' else 422,content={'detail':str(exc)})
+
+    @app.post('/api/v2/resumes/{resume_id}/matches',response_model=MatchView,status_code=201)
+    def analyze(resume_id: str, request: AnalyzeRequest, user: str=Depends(owner)):
+        if request.mode=='llm':
+            if not request.allow_external_processing:
+                raise HTTPException(422,'external_processing_consent_required')
+            if matcher.provider is None:raise MatchError('match_model_unavailable')
+        match_id, version, execute = repository.begin(user,resume_id,request)
+        if execute:
+            try:
+                payload = matcher.analyze(match_id,version,request)
+                repository.complete(user,match_id,payload)
+            except MatchError as exc:
+                repository.fail(user,match_id,str(exc))
+                raise
+            except Exception as exc:
+                repository.fail(user,match_id,'match_analysis_failed')
+                raise MatchError('match_analysis_failed') from exc
+        return repository.get(user,match_id)
+
+    @app.get('/api/v2/resumes/{resume_id}/matches',response_model=list[MatchSummary])
+    def list_matches(resume_id: str, user: str=Depends(owner)):
+        return repository.list(user,resume_id)
+
+    @app.get('/api/v2/matches/{match_id}',response_model=MatchView)
+    def get_match(match_id: str, user: str=Depends(owner)):
+        return repository.get(user,match_id)
+
+    @app.post('/api/v2/matches/{match_id}/proposals/{proposal_id}/decision',response_model=DecisionResult)
+    def decide(match_id: str, proposal_id: str, request: DecideProposal, user: str=Depends(owner)):
+        return repository.decide(user,match_id,proposal_id,request)
--- M2A/src/job_agent/resume_workspace/match_contracts.py
+++ M3/src/job_agent/resume_workspace/match_contracts.py
@@ -0,0 +1,124 @@
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Literal
+
+from pydantic import Field, field_validator
+
+from job_agent.evidence.contracts import EvidenceBundle
+from job_agent.resume_workspace.contracts import ResumeFact, VersionRecord
+from job_agent.resume_workspace.parsing_contracts import ParseUsage
+from job_agent.schemas import StrictModel
+from job_agent.text_identity import normalize_text
+
+
+class MatchError(ValueError):
+    pass
+
+
+class AnalyzeRequest(StrictModel):
+    request_key: str = Field(pattern=r"^[a-zA-Z0-9_-]{8,80}$")
+    version_id: str = Field(min_length=1, max_length=64)
+    expected_content_hash: str = Field(pattern=r"^[a-f0-9]{64}$")
+    title: str = Field(min_length=1, max_length=120)
+    jd_text: str = Field(min_length=1, max_length=15_000)
+    mode: Literal["local_check", "llm"] = "local_check"
+    allow_external_processing: bool = False
+
+    @field_validator("jd_text")
+    @classmethod
+    def canonical_jd(cls, value):
+        value = normalize_text(value).strip()
+        if not value:
+            raise ValueError("empty_jd")
+        return value
+
+
+class OrderProposal(StrictModel):
+    proposal_id: str
+    section: Literal["projects", "experience", "skills"]
+    target_id: str
+    title: str
+    reason: str
+    preview: str
+
+
+class MatchPayload(StrictModel):
+    schema_version: Literal[1] = 1
+    match_id: str
+    resume_id: str
+    version_id: str
+    version_hash: str
+    title: str
+    jd_text: str
+    mode: Literal["local_check", "llm"]
+    bundle: EvidenceBundle
+    proposals: list[OrderProposal]
+    usage: ParseUsage
+    created_at: datetime
+
+
+class MatchLinkView(StrictModel):
+    path: str
+    quote: str
+    # Original workspace span, not a path into a temporary artifact folder.
+    fact: ResumeFact
+    level: Literal["C1"] = "C1"
+    support_status: Literal["supported", "partial", "unsupported", "contradictory"]
+
+
+class MatchRowView(StrictModel):
+    atom_id: str
+    text: str
+    importance: str
+    jd_quote: str
+    jd_start: int
+    jd_end: int
+    match_status: str
+    has_contradiction: bool
+    rationale: str
+    links: list[MatchLinkView]
+
+
+class ProposalView(OrderProposal):
+    decision: Literal["pending", "accepted", "rejected"] = "pending"
+    accepted_version_id: str | None = None
+
+
+class MatchView(StrictModel):
+    match_id: str
+    resume_id: str
+    version_id: str
+    version_hash: str
+    title: str
+    jd_text: str
+    mode: Literal["local_check", "llm"]
+    provider: str
+    model: str
+    usage: ParseUsage
+    created_at: datetime
+    expected_head_version_id: str
+    can_apply: bool
+    rows: list[MatchRowView]
+    proposals: list[ProposalView]
+    warnings: list[str]
+
+
+class MatchSummary(StrictModel):
+    match_id: str
+    title: str
+    version_id: str
+    status: Literal["running", "complete", "failed"]
+    error_code: str | None = None
+    created_at: datetime
+
+
+class DecideProposal(StrictModel):
+    action: Literal["accept", "reject"]
+    expected_parent_version_id: str
+    user_reviewed: Literal[True]
+
+
+class DecisionResult(StrictModel):
+    match: MatchView
+    version: VersionRecord | None = None
--- M2A/src/job_agent/resume_workspace/match_repository.py
+++ M3/src/job_agent/resume_workspace/match_repository.py
@@ -0,0 +1,173 @@
+"""SQLite match snapshots and transactional acceptance of order-only suggestions."""
+from __future__ import annotations
+
+import json
+from uuid import uuid4
+
+from job_agent.resume_workspace.contracts import ResumeDocument
+from job_agent.resume_workspace.match_contracts import (
+    AnalyzeRequest, DecideProposal, DecisionResult, MatchError, MatchPayload,
+    MatchSummary, MatchView, ProposalView,
+)
+from job_agent.resume_workspace.matching import digest, propose_order, row_views, VersionSourceStore
+from job_agent.resume_workspace.repository import (
+    InvalidProvenance, SqliteResumeRepository, WorkspaceConflict, WorkspaceNotFound, _now,
+)
+
+
+DDL = """
+CREATE TABLE IF NOT EXISTS rw_matches (
+    match_id TEXT PRIMARY KEY, owner_id TEXT NOT NULL,
+    resume_id TEXT NOT NULL REFERENCES rw_resumes(resume_id) ON DELETE CASCADE,
+    version_id TEXT NOT NULL REFERENCES rw_versions(version_id) ON DELETE CASCADE,
+    request_key TEXT NOT NULL, request_hash TEXT NOT NULL, request_json TEXT NOT NULL,
+    title TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL,
+    payload_json TEXT, payload_hash TEXT, error_code TEXT, expected_head TEXT NOT NULL,
+    UNIQUE(owner_id,request_key)
+);
+CREATE INDEX IF NOT EXISTS rw_matches_resume ON rw_matches(owner_id,resume_id);
+CREATE TABLE IF NOT EXISTS rw_match_decisions (
+    match_id TEXT NOT NULL REFERENCES rw_matches(match_id) ON DELETE CASCADE,
+    proposal_id TEXT NOT NULL, decision TEXT NOT NULL,
+    accepted_version_id TEXT REFERENCES rw_versions(version_id) ON DELETE CASCADE,
+    PRIMARY KEY(match_id,proposal_id)
+);
+"""
+
+
+class MatchRepository:
+    def __init__(self, workspace: SqliteResumeRepository):
+        self.workspace = workspace
+        with workspace._connection() as db:
+            db.executescript(DDL)
+
+    def begin(self, owner: str, resume_id: str, request: AnalyzeRequest):
+        encoded = request.model_dump_json(exclude={'request_key','allow_external_processing'})
+        request_hash = digest(resume_id + encoded)
+        with self.workspace._connection(write=True) as db:
+            self.workspace._resume(db,owner,resume_id)
+            version = self.workspace._version(db,resume_id,request.version_id)
+            self.workspace._validate_document(db,owner,version.document)
+            if version.content_hash != request.expected_content_hash:
+                raise WorkspaceConflict('match_version_changed')
+            existing = db.execute('SELECT * FROM rw_matches WHERE owner_id=? AND request_key=?',(owner,request.request_key)).fetchone()
+            if existing:
+                if existing['request_hash'] != request_hash:
+                    raise WorkspaceConflict('match_request_key_conflict')
+                if existing['status'] == 'running':
+                    raise WorkspaceConflict('match_in_progress')
+                if existing['status'] == 'failed':
+                    raise WorkspaceConflict('match_previous_failed')
+                return existing['match_id'], version, False
+            match_id = 'match-' + uuid4().hex
+            db.execute('INSERT INTO rw_matches VALUES (?,?,?,?,?,?,?,?,?,?,NULL,NULL,NULL,?)',
+                       (match_id,owner,resume_id,version.version_id,request.request_key,request_hash,encoded,
+                        request.title,'running',_now(),version.version_id))
+            return match_id, version, True
+
+    def _row(self, db, owner, match_id):
+        row = db.execute('SELECT * FROM rw_matches WHERE match_id=? AND owner_id=?',(match_id,owner)).fetchone()
+        if row is None:raise WorkspaceNotFound('match_not_found')
