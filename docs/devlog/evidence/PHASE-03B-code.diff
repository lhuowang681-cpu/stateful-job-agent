+
+
+def test_external_edit_blocks_old_proposal_but_not_history(setup):
+    repo,v=setup; client,view=start(setup)
+    repo.edit_version('alice',v.resume_id,v.version_id,EditVersion(edits=[FieldEdit(path='skills.0',value='SQLite')]))
+    assert client.post(decision_url(view),headers=A,json=decide(view,v)).status_code==409
+    current=client.get(f"/api/v2/collaborations/{view['state']['run_id']}",headers=A).json()
+    assert not current['can_apply'] and current['state']['jd_text']==JD
+
+
+def test_simultaneous_accept_creates_one_version(setup):
+    repo,v=setup; _,view=start(setup); store=CollaborationRepository(repo)
