+class FixtureProvider:
+    provider_name='synthetic-fixture'; model='not-a-real-model'
+    def __init__(self,v,*,timeout=False,bad_schema=False,always_revise=False,wrong_ids=False):
+        self.v=v;self.calls=[];self.timeout=timeout;self.bad_schema=bad_schema;self.always_revise=always_revise;self.wrong_ids=wrong_ids
+    def generate_structured(self,**kw):
+        self.calls.append(kw)
+        if self.timeout:raise ProviderTimeoutError('synthetic failure')
+        if self.bad_schema:raw={'unallowed':'never-output-sensitive-prompt'}
+        elif kw['output_schema'] is WriterDraft:
+            raw={'proposals':[{'proposal_id':'p','source_path':'projects.1.bullets.0','text':self.v.document.projects[1].bullets[0].text,'reason':'合成选择'}]}
+        else:raw={'items':[{'proposal_id':'forged' if self.wrong_ids else 'p','outcome':'revise' if self.always_revise else 'accept','issue_code':'unrelated' if self.always_revise else 'none','constraint':'合成反馈'}]}
+        return result_from_raw_output(provider=self.provider_name,model=self.model,raw_output=json.dumps(raw),output_schema=kw['output_schema'],trace=kw['trace'],latency_ms=1,input_tokens=10,output_tokens=5)
