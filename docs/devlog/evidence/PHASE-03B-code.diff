+    assert new['document']['projects']==v.document.model_dump(mode='json')['projects']
+    assert new['confirmed_at'] is None and new['sequence']==2
+    assert client.post(decision_url(view),headers=A,json=decide(view,v)).json()['version']['version_id']==new['version_id']
+    assert len(repo.list_versions('alice',v.resume_id))==2
+    # Existing C1 projection remains unverified even after copying/confirmation.
+    from job_agent.resume_workspace.matching import VersionSourceStore
