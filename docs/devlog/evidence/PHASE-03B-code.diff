+"""Synthetic contracts, not live model quality or a collaboration benchmark."""
+from concurrent.futures import ThreadPoolExecutor
+import json
+import sqlite3
+
+from fastapi.testclient import TestClient
+import pytest
+
+from job_agent.llm.providers.mock import result_from_raw_output
+from job_agent.llm.provider import ProviderTimeoutError
+from job_agent.resume_workspace.api import create_resume_app
+from job_agent.resume_workspace.collaboration import CollaborationEngine, LocalRoles, eligible_facts, hard_review
+from job_agent.resume_workspace.collaboration_contracts import (
+    CollaborationDecision, CollaborationRequest, ReviewerOutput, ReviewItem, WriterDraft, SummaryProposal,
+)
+from job_agent.resume_workspace.collaboration_repository import CollaborationRepository
+from job_agent.resume_workspace.contracts import SourceCreate, VersionCreate
+from job_agent.resume_workspace.parsing import ResumeParser
+from job_agent.resume_workspace.parsing_contracts import AcceptDraft, EditVersion, FieldEdit
+from job_agent.resume_workspace.repository import SqliteResumeRepository, WorkspaceConflict, InvalidProvenance
+
+TEXT='''姓名：合成同学
+邮箱：never-send@example.invalid
+项目经历
+校园海报 | 设计 | 2024
+- 使用图像工具完成校园海报。
+RAG 检索平台 | 后端开发 | 2025
+- 使用 Python 实现 RAG 检索接口。
+- 未使用 Kubernetes 进行生产部署。
+技能
+SQL、Python
+'''
+JD='使用 Python 开发接口，具备 RAG 检索项目实践。'
+A={'Authorization':'Bearer alice-token'}
+B={'Authorization':'Bearer bob-token'}
+
+
+@pytest.fixture
+def setup(tmp_path):
+    repo=SqliteResumeRepository(tmp_path/'workspace.sqlite')
+    src=repo.add_source('alice',SourceCreate(kind='original_resume',label='合成',text=TEXT))
+    draft=repo.save_draft('alice',ResumeParser().parse(src))
+    v=repo.accept_draft('alice',draft.draft_id,AcceptDraft(title='合成简历',expected_source_hash=src.content_hash,user_reviewed=True))
+    return repo,v
+
+
+def request(v,**kw):
+    return CollaborationRequest(**dict(request_key='collab-test-key-123',version_id=v.version_id,
+        expected_content_hash=v.content_hash,jd_text=JD,**kw))
+
+
+def client_for(repo,engine=None):
+    return TestClient(create_resume_app(repo,resolve_identity={'alice-token':'alice','bob-token':'bob'}.get,collaboration_engine=engine))
+
+
+def start(setup,engine=None,req=None):
+    repo,v=setup; client=client_for(repo,engine)
+    result=client.post(f'/api/v2/resumes/{v.resume_id}/collaborations',headers=A,json=(req or request(v)).model_dump())
+    assert result.status_code==201,result.text
+    return client,result.json()
+
+
+def decide(view,v,**kw):
+    d=view['state']['drafts'][-1]
+    return dict(action='accept',expected_parent_version_id=v.version_id,draft_revision=d['revision'],draft_hash=d['draft_hash'],user_reviewed=True,**kw)
+
+
+def decision_url(view):
+    p=view['state']['drafts'][-1]['draft']['proposals'][0]
+    return f"/api/v2/collaborations/{view['state']['run_id']}/proposals/{p['proposal_id']}/decision"
+
+
+def test_feedback_really_changes_selection_and_trace_has_no_thoughts(setup):
+    _,view=start(setup); s=view['state']; drafts=s['drafts']
+    assert s['status']=='awaiting_approval' and s['revision']==2
+    assert drafts[0]['draft']['proposals'][0]['source_path']=='projects.0.bullets.0'
+    assert drafts[0]['feedback']['items'][0]['issue_code']=='unrelated'
+    assert drafts[1]['draft']['proposals'][0]['source_path']=='projects.1.bullets.0'
+    assert s['usage']['writer_calls']==s['usage']['reviewer_calls']==2
+    assert s['usage']['provider_calls']==0 and s['usage']['cost'] is None
+    assert [m['kind'] for m in s['messages']]==['review_request','review_feedback','revision_request','review_request','review_feedback','user_approval']
+    assert all(m['artifact_hash']==drafts[m['draft_revision']-1]['draft_hash'] for m in s['messages'])
+    assert 'chain_of_thought' not in json.dumps(view)
+
+
+def test_first_relevant_quote_is_not_forced_to_revision(setup):
+    repo,v=setup
+    edited=repo.edit_version('alice',v.resume_id,v.version_id,EditVersion(edits=[FieldEdit(path='projects.0.bullets.0',value='使用 Python 进行接口测试。')]))
+    _,view=start((repo,edited))
+    assert view['state']['revision']==1 and view['state']['status']=='awaiting_approval'
