+    assert all(d.kind=='original_resume' for d in VersionSourceStore(selected,JD).catalog.documents if d.source_id!='jd')
+
+
+def test_reject_is_idempotent_and_no_version_can_be_created_later(setup):
+    repo,v=setup; client,view=start(setup); req={**decide(view,v),'action':'reject'}
+    assert client.post(decision_url(view),headers=A,json=req).json()['version'] is None
+    assert client.post(decision_url(view),headers=A,json=req).status_code==200
+    assert client.post(decision_url(view),headers=A,json=decide(view,v)).status_code==409
+    assert len(repo.list_versions('alice',v.resume_id))==1
+
+
+@pytest.mark.parametrize('change',[{'draft_revision':1},{'draft_hash':'0'*64},{'expected_parent_version_id':'wrong'}, {'user_reviewed':False}])
+def test_stale_or_unreviewed_approvals_fail(setup,change):
