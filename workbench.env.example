# Public placeholders only. Configure locally; do not commit real values.
JOB_AGENT_WORKSPACE_API_TOKEN=REPLACE_LOCALLY_WITH_AT_LEAST_32_ASCII_CHARACTERS
JOB_AGENT_WORKSPACE_DB=output/resume-workspace/workspace.sqlite
# Project/index/task authority; resume/interview records continue using WORKSPACE_DB.
JOB_AGENT_PROJECT_BACKEND=sqlite
# When postgresql is selected, set a private DSN outside source control.
# JOB_AGENT_PROJECT_DSN=host=/private/unix/socket dbname=job_agent user=app_role
JOB_AGENT_PROJECT_SCHEMA=job_agent_v3
# redis requires PostgreSQL, a matching persisted scheduler mode, and independent publisher/worker.
JOB_AGENT_INDEX_DISPATCH=polling
# JOB_AGENT_INDEX_REDIS_URL=unix:///private/redis/socket?db=0
JOB_AGENT_WORKSPACE_ENABLE_LLM=0
JOB_AGENT_WORKSPACE_MODEL_NAME=deepseek-flash
JOB_AGENT_WORKSPACE_MODEL_THINKING=disabled
JOB_AGENT_WORKSPACE_MODEL_KEY=

# Explicit offline retrieval. Does not enable paid LLM calls.
JOB_AGENT_WORKSPACE_EMBEDDING=disabled
JOB_AGENT_WORKSPACE_EMBEDDING_PATH=
JOB_AGENT_WORKSPACE_EMBEDDING_DEVICE=cpu
JOB_AGENT_WORKSPACE_RERANK_PATH=
JOB_AGENT_WORKSPACE_RERANK_DEVICE=cpu
# Set EMBEDDING=local_qwen and a local model directory to load it at startup.
# Code vectors publish inside index tasks; rebuild existing code indexes after
# changing model/config. Public doc/question vectors prewarm at startup.
