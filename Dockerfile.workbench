FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src:/app
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY fit_verdict_engine/ ./fit_verdict_engine/
RUN pip install --no-cache-dir '.[workbench]'
COPY scripts/ ./scripts/
COPY docs/demo/assets/ ./docs/demo/assets/
COPY --from=web /web/dist/ ./frontend/dist/
RUN mkdir -p /app/output && useradd --uid 10001 --create-home appuser && chown -R appuser:appuser /app/output /app/docs/demo/assets
USER appuser
EXPOSE 8019
CMD ["python","scripts/demo_resume_workbench.py","--host","0.0.0.0","--port","8019","--persistent","--seed"]
